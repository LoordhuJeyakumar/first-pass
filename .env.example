# First Pass — environment variable template.
# Copy this file to .env and fill in real values. Never commit .env.
#
#   cp .env.example .env
#
# Placeholder format: uppercase strings only.
# Lowercase hostnames or realistic token formats will trip the pre-commit disclosure check.
# See docs/DISCLOSURE.md for the full secret hygiene policy.

# Grafana Cloud stack base URL (e.g. https://YOUR-STACK.grafana.net).
# Note: Consumed by mcp/docker-compose.yml container rather than directly by Python.
GRAFANA_URL=https://YOUR-STACK.grafana.net

# Grafana service-account token (Editor role). Generate in Grafana → Administration → Service accounts.
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_REPLACE_ME

# Google Cloud project ID with Vertex AI API enabled.
GOOGLE_CLOUD_PROJECT=YOUR-GOOGLE-CLOUD-PROJECT

# Google Cloud region/location for Vertex AI API.
GOOGLE_CLOUD_LOCATION=us-central1

# Google GenAI SDK Vertex AI mode toggle.
GOOGLE_GENAI_USE_VERTEXAI=true

# URL of the self-hosted mcp-grafana endpoint (defaults to localhost:8000 if unset).
MCP_SERVER_URL=http://YOUR-MCP-VM-HOST:8000/mcp


# Prometheus Remote-Write URL & Username for Grafana Cloud Metrics
PROM_REMOTE_WRITE_URL=https://prometheus-YOUR-REGION.grafana.net/api/v1/push
PROM_USERNAME=YOUR_PROMETHEUS_USERNAME

# Loki Push URL & Username for Grafana Cloud Logs
LOKI_PUSH_URL=https://logs-YOUR-REGION.grafana.net/loki/api/v1/push
LOKI_USERNAME=YOUR_LOKI_USERNAME

# Grafana Cloud API key / Access Policy token for Remote-Write and Loki Push
GRAFANA_CLOUD_API_KEY=glsa_REPLACE_ME

# Operator console — seconds between runs (prevents duplicate incidents; default: 30).
CONSOLE_COOLDOWN_SECONDS=30

# GCE VM used by scripts/deploy.sh (uppercase placeholders only).
GCE_INSTANCE=YOUR-GCE-INSTANCE
GCE_ZONE=YOUR-GCE-ZONE
CONSOLE_URL=https://YOUR-CONSOLE-HOST
